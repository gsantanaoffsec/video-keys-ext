{
  "manifest_version": 3,
  "name": "Video Keys",
  "version": "2.1.0",
  "description": "Atalhos de teclado tipo YouTube para players ruins. Fica inativa por padrao: so funciona nos sites que voce liberar.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Video Keys — sites liberados",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "shared.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": [
        "content.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "video-keys@gabriel.dev",
      "strict_min_version": "121.0"
    }
  }
}
